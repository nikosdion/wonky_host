# Dockerfile for the Nginx container
FROM nginx:latest
LABEL maintainer="Nicholas K. Dionysopoulos"

# Drop the reverse proxy template into the path the upstream nginx image's
# entrypoint scans for envsubst-templated config snippets. Any *.template
# file here is rendered with the container's environment and emitted to
# /etc/nginx/conf.d/ before nginx starts, so ${DOMAIN_NAME} (and friends)
# resolve at container start without us shipping our own entrypoint.
COPY nginx.conf.template /etc/nginx/templates/repro.conf.template

EXPOSE 8942